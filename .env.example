# Copy this file to .env.local (for npm run dev / npm start) and to .env (for docker compose).

# Secret used to sign the login session cookie. Required in production (npm start / Docker).
# Generate one with: openssl rand -base64 32
# or in PowerShell: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Max 256 }))
AUTH_SECRET=

# PostgreSQL connection string: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# - Windows native PostgreSQL: usually port 5432
# - Database from `docker compose up -d db`: port 5433 (see DB_PORT below)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/expense_tracker

# Used by docker-compose.yml only.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=expense_tracker
DB_PORT=5433
APP_PORT=3000
